diff --git a/lib/mount_darwin.c b/lib/mount_darwin.c
new file mode 100644
index 0000000..a527576
--- /dev/null
+++ b/lib/mount_darwin.c
@@ -0,0 +1,344 @@
+/*
+ * FUSE: Filesystem in Userspace
+ * Darwin mount backend.
+ *
+ * Copyright (C) 2026 Håvard Sørbø <havard@hsorbo.no>
+ *
+ * This program can be distributed under the terms of the GNU LGPLv2.
+ * See the file LGPL2.txt.
+ *
+ * As in mount.c without root, fusermount3 mounts and passes back the
+ * channel over $_FUSE_COMMFD; unknown -o options go to it. The channel is a
+ * stream socket (no SOCK_SEQPACKET on macOS), so I/O is reframed.
+ */
+
+#include "fuse_config.h"
+#include "fuse_i.h"
+#include "fuse_kernel.h"
+/* libfuse >= 3.19 moved the mount option declarations out of fuse_i.h. */
+#if __has_include("mount_common_i.h")
+#include "mount_common_i.h"
+#define MOUNT_OPTS_CONST const
+#else
+#define MOUNT_OPTS_CONST
+#endif
+#include "fuse_misc.h"
+#include "fuse_opt.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <pthread.h>
+#include <spawn.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/uio.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+extern char **environ;
+
+#define FUSERMOUNT_PROG		"fusermount3"
+#define FUSE_COMMFD_ENV		"_FUSE_COMMFD"
+
+struct mount_opts {
+	char *helper_opts;
+	unsigned int max_read;
+};
+
+enum {
+	KEY_RO,
+};
+
+static const struct fuse_opt fuse_mount_opts[] = {
+	{ "max_read=%u", offsetof(struct mount_opts, max_read), 0 },
+	FUSE_OPT_KEY("-r", KEY_RO),
+	FUSE_OPT_END
+};
+
+unsigned int get_max_read(MOUNT_OPTS_CONST struct mount_opts *o)
+{
+	return o->max_read;
+}
+
+static int fuse_mount_opt_proc(void *data, const char *arg, int key,
+			       struct fuse_args *outargs)
+{
+	struct mount_opts *mo = data;
+
+	(void) outargs;
+
+	switch (key) {
+	case KEY_RO:
+		return fuse_opt_add_opt(&mo->helper_opts, "ro");
+	case FUSE_OPT_KEY_OPT:
+		return fuse_opt_add_opt_escaped(&mo->helper_opts, arg);
+	}
+	return 1;
+}
+
+struct mount_opts *parse_mount_opts(struct fuse_args *args)
+{
+	struct mount_opts *mo = calloc(1, sizeof(*mo));
+
+	if (mo == NULL)
+		return NULL;
+	if (args &&
+	    fuse_opt_parse(args, mo, fuse_mount_opts, fuse_mount_opt_proc) == -1) {
+		destroy_mount_opts(mo);
+		return NULL;
+	}
+	return mo;
+}
+
+void destroy_mount_opts(struct mount_opts *mo)
+{
+	if (mo == NULL)
+		return;
+	free(mo->helper_opts);
+	free(mo);
+}
+
+static pthread_mutex_t read_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_mutex_t write_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static void unlock_mutex(void *m)
+{
+	pthread_mutex_unlock(m);
+}
+
+/* Bytes read, 0 on EOF, or -errno; EINTR lets fuse_session_exit() work. */
+static ssize_t read_exact(int fd, void *buf, size_t len, int allow_eintr)
+{
+	size_t got = 0;
+
+	while (got < len) {
+		ssize_t n = recv(fd, (char *) buf + got, len - got, 0);
+
+		if (n < 0) {
+			if (errno == EINTR && (!allow_eintr || got > 0))
+				continue;
+			return -errno;
+		}
+		if (n == 0)
+			return got == 0 ? 0 : -ECONNRESET;
+		got += (size_t) n;
+	}
+	return (ssize_t) got;
+}
+
+static ssize_t darwin_read(int fd, void *buf, size_t buf_len, void *userdata)
+{
+	struct fuse_in_header *in = buf;
+	ssize_t res;
+
+	(void) userdata;
+	if (buf_len < sizeof(*in))
+		return -EINVAL;
+
+	pthread_mutex_lock(&read_lock);
+	pthread_cleanup_push(unlock_mutex, &read_lock);
+
+	res = read_exact(fd, buf, sizeof(*in), 1);
+	if (res > 0) {
+		if (in->len < sizeof(*in) || in->len > buf_len) {
+			fuse_log(FUSE_LOG_ERR,
+				 "fuse: bad request length %u (buffer %zu)\n",
+				 in->len, buf_len);
+			res = -EIO;
+		} else if (in->len > sizeof(*in)) {
+			res = read_exact(fd, (char *) buf + sizeof(*in),
+					 in->len - sizeof(*in), 0);
+			if (res == 0)
+				res = -ECONNRESET;
+			if (res > 0)
+				res = in->len;
+		} else {
+			res = in->len;
+		}
+	}
+	if (res == 0 || res == -ECONNRESET)
+		res = -ENODEV;
+
+	pthread_cleanup_pop(1);
+	return res;
+}
+
+static ssize_t darwin_writev(int fd, struct iovec *iov, int count,
+			     void *userdata)
+{
+	ssize_t total = 0, res = 0;
+
+	(void) userdata;
+	pthread_mutex_lock(&write_lock);
+	pthread_cleanup_push(unlock_mutex, &write_lock);
+	while (count > 0) {
+		res = writev(fd, iov, count);
+		if (res < 0) {
+			if (errno == EINTR || errno == EAGAIN)
+				continue;
+			res = -errno;
+			break;
+		}
+		total += res;
+		while (count > 0 && (size_t) res >= iov->iov_len) {
+			res -= (ssize_t) iov->iov_len;
+			iov++;
+			count--;
+		}
+		if (count > 0) {
+			iov->iov_base = (char *) iov->iov_base + res;
+			iov->iov_len -= (size_t) res;
+		}
+		res = total;
+	}
+	pthread_cleanup_pop(1);
+	return res < 0 ? res : total;
+}
+
+static const struct fuse_custom_io darwin_io = {
+	.writev = darwin_writev,
+	.read = darwin_read,
+};
+
+int fuse_darwin_session_attach(struct fuse_session *se, int fd)
+{
+	return fuse_session_custom_io_317(se, &darwin_io, sizeof(darwin_io), fd);
+}
+
+/* Fallbacks when fusermount3 is not in $PATH (e.g. under launchd). */
+static const char *const helper_dirs[] = {
+	FUSERMOUNT_DIR, "/opt/homebrew/bin", "/usr/local/bin", NULL
+};
+
+static int spawn_helper(const char *const argv[],
+			posix_spawn_file_actions_t *fa, pid_t *pid)
+{
+	char path[PATH_MAX];
+	int res = posix_spawnp(pid, FUSERMOUNT_PROG, fa, NULL,
+			       (char *const *) argv, environ);
+
+	for (int i = 0; res != 0 && helper_dirs[i]; i++) {
+		snprintf(path, sizeof(path), "%s/" FUSERMOUNT_PROG,
+			 helper_dirs[i]);
+		res = posix_spawn(pid, path, fa, NULL, (char *const *) argv,
+				  environ);
+	}
+	if (res != 0)
+		fuse_log(FUSE_LOG_ERR, "fuse: cannot run %s: %s\n",
+			 FUSERMOUNT_PROG, strerror(res));
+	return res == 0 ? 0 : -1;
+}
+
+void fuse_mount_version(void)
+{
+	const char *const argv[] = { FUSERMOUNT_PROG, "--version", NULL };
+	pid_t pid;
+
+	if (spawn_helper(argv, NULL, &pid) == 0)
+		waitpid(pid, NULL, 0);
+}
+
+/* From mount.c. */
+static int receive_fd(int fd)
+{
+	struct msghdr msg;
+	struct iovec iov;
+	char buf[1];
+	ssize_t rv;
+	size_t ccmsg[CMSG_SPACE(sizeof(int)) / sizeof(size_t)];
+	struct cmsghdr *cmsg;
+
+	iov.iov_base = buf;
+	iov.iov_len = 1;
+
+	memset(&msg, 0, sizeof(msg));
+	msg.msg_iov = &iov;
+	msg.msg_iovlen = 1;
+	msg.msg_control = ccmsg;
+	msg.msg_controllen = sizeof(ccmsg);
+
+	while ((rv = recvmsg(fd, &msg, 0)) == -1 && errno == EINTR)
+		;
+	if (rv <= 0)
+		return -1;
+
+	cmsg = CMSG_FIRSTHDR(&msg);
+	if (!cmsg || cmsg->cmsg_type != SCM_RIGHTS) {
+		fuse_log(FUSE_LOG_ERR, "fuse: %s sent no file descriptor\n",
+			 FUSERMOUNT_PROG);
+		return -1;
+	}
+	return *(int *) CMSG_DATA(cmsg);
+}
+
+int fuse_kern_mount(const char *mountpoint, struct mount_opts *mo)
+{
+	const char *const argv[] = {
+		FUSERMOUNT_PROG, "-o", mo->helper_opts ? mo->helper_opts : "",
+		"--", mountpoint, NULL
+	};
+	posix_spawn_file_actions_t fa;
+	char commfd[16];
+	int fds[2], fd, status = 0, one = 1;
+	pid_t pid;
+
+	if (mountpoint == NULL) {
+		fuse_log(FUSE_LOG_ERR, "fuse: missing mountpoint parameter\n");
+		return -1;
+	}
+	if (socketpair(AF_UNIX, SOCK_STREAM, 0, fds) < 0) {
+		fuse_log(FUSE_LOG_ERR, "fuse: socketpair: %s\n", strerror(errno));
+		return -1;
+	}
+	snprintf(commfd, sizeof(commfd), "%i", fds[0]);
+	setenv(FUSE_COMMFD_ENV, commfd, 1);
+	posix_spawn_file_actions_init(&fa);
+	posix_spawn_file_actions_addclose(&fa, fds[1]);
+	status = spawn_helper(argv, &fa, &pid);
+	posix_spawn_file_actions_destroy(&fa);
+	unsetenv(FUSE_COMMFD_ENV);
+	close(fds[0]);
+	if (status < 0) {
+		close(fds[1]);
+		return -1;
+	}
+
+	fd = receive_fd(fds[1]);
+	close(fds[1]);
+	waitpid(pid, &status, 0);
+	if (fd >= 0 && !(WIFEXITED(status) && WEXITSTATUS(status) == 0)) {
+		close(fd);
+		fd = -1;
+	}
+	if (fd < 0)
+		return -1;
+
+	fcntl(fd, F_SETFD, FD_CLOEXEC);
+	setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof(one));
+	{
+		int size = 4 * 1024 * 1024;
+
+		setsockopt(fd, SOL_SOCKET, SO_SNDBUF, &size, sizeof(size));
+		setsockopt(fd, SOL_SOCKET, SO_RCVBUF, &size, sizeof(size));
+	}
+	return fd;
+}
+
+void fuse_kern_unmount(const char *mountpoint, int fd)
+{
+	const char *const argv[] = {
+		FUSERMOUNT_PROG, "-u", "-q", "-z", "--", mountpoint, NULL
+	};
+	pid_t pid;
+
+	if (fd >= 0) {
+		shutdown(fd, SHUT_RDWR);
+		close(fd);
+	}
+	if (mountpoint && spawn_helper(argv, NULL, &pid) == 0)
+		waitpid(pid, NULL, 0);
+}
